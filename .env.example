# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен HuggingFace (нужен для gated-моделей, например Llama, и для публикации адаптеров)
HF_TOKEN=

# Трекинг экспериментов: mlflow | wandb | none
TRACKING_BACKEND=mlflow
MLFLOW_TRACKING_URI=./mlruns
WANDB_API_KEY=
WANDB_PROJECT=neural-astigmatism
