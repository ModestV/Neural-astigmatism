# Локальные исходники и производные данные. Описания можно отслеживать.
/drawings/*
!/drawings/.gitkeep
!/drawings/README.md
/cache/*
!/cache/.gitkeep
/results/*
!/results/.gitkeep
!/results/README.md
__pycache__/
*.py[cod]

# Резервные копии редактора
/annotations/.annotation_backups/
/annotations/*.tmp
